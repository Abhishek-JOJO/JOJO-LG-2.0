<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/widgets" 
        id="in.jojoapp" 
        version="1.0.12" 
        viewmodes="fullscreen">
    
    <!-- ✅ Application ID and Package -->
    <tizen:application id="EGy8Igm3no.JOJO" 
                       package="EGy8Igm3no" 
                         required_version="2.3" />
    
    <!-- ✅ Entry Point -->
    <content src="index.html"/>
    
    <!-- ✅ Screen Size Support -->
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    
    <!-- ✅ App Icon -->
    <icon src="icon.png"/>
    
    <!-- ✅ Base Screen Resolution -->
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" 
                    value="extensive"/>
    
    <!-- ✅ App Name -->
    <name>JOJO APP Movies, Shows, Natak</name>
    
    <!-- ✅ Profile -->
    <tizen:profile name="tv-samsung"/>
    
    <!-- ✅ Settings -->
    <tizen:setting screen-orientation="landscape" 
                   context-menu="enable" 
                   background-support="disable" 
                   encryption="disable" 
                   install-location="auto" 
                   hwkey-event="enable"/>
    
    <!-- ✅ CRITICAL: Privileges for Network Access -->
    <tizen:privileges>
        <!-- Internet access (REQUIRED for API calls) -->
        <tizen:privilege name="http://tizen.org/privilege/internet"/>
        
        <!-- ✅ NETWORK FIX: Add network.get & network.public privileges for TV network access -->
        <tizen:privilege name="http://tizen.org/privilege/network.get"/>
        <tizen:privilege name="http://tizen.org/privilege/network.public"/>
        
        <!-- ✅ RECOMMENDED: Application management -->
        <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
        
        <!-- ✅ RECOMMENDED: TV input device (for remote control) -->
        <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    </tizen:privileges>
    
    <!-- ✅ Content Security Policy (CSP) - Permissive for TV Network Requests -->
    <tizen:content-security-policy>
        default-src * 'unsafe-inline' 'unsafe-eval' data: gap: blob:;
        script-src * 'unsafe-inline' 'unsafe-eval';
        style-src * 'unsafe-inline';
        font-src * data:;
        img-src * data: blob: https: http:;
        media-src * blob: https: http:;
        connect-src * https: http: wss: ws:;
        frame-src *;
    </tizen:content-security-policy>
    
    <!-- ✅ Content Security Policy Report Only (for debugging) -->
    <tizen:content-security-policy-report-only>
        default-src *; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline';
    </tizen:content-security-policy-report-only>
    
    <!-- ✅ Allow Navigation -->
    <tizen:allow-navigation>*</tizen:allow-navigation>
    
    <!-- ✅ CRITICAL: Allow Cross-Origin Network Access (Fixes Network Error) -->
    <access origin="*" subdomains="true"></access>
    
    <!-- ✅ App Control (for deep linking) -->
    <tizen:app-control>
        <tizen:src name="index.html"/>
        <tizen:operation name="http://tizen.org/appcontrol/operation/default"/>
    </tizen:app-control>
    
</widget>