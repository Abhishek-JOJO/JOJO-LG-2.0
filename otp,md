## 🔄 Complete Authentication Flow

### Step 1: User Input
**Component**: `FreeTrialForm.tsx`

```typescript
const handleSubmit = (e: React.FormEvent) => {
  e.preventDefault();
  const trimmed = inputValue.trim();
  
  // Detect input type
  const isEmailInput = trimmed.includes("@") || /[a-zA-Z]/.test(trimmed);
  
  // Format phone number
  if (!isEmailInput && !trimmed.startsWith("+")) {
    const cleanPhone = trimmed.replace(/\D/g, "");
    fullIdentifier = `${selectedCountry.phoneCode}${cleanPhone}`;
  }
  
  onSubmit(fullIdentifier);
};
```

### Step 2: Send OTP
**API**: `sendOtp.ts`

```typescript
export async function sendOtp(
  request: SendOtpRequest,
  sessionId?: string
): Promise<ApiResponse<any>> {
  const body: any = {
    is_register: request.is_register,
    source: request.source,
    domain: window.location.hostname // ← Critical for WebOTP
  };

  if (request.source === LoginIdentifierType.PHONE) {
    body.phone = request.phone;
    body.phone_code = request.phone_code;
  } else {
    body.email = request.phone;
  }

  return apiClient.post(ApiEndpoint.SEND_OTP, body, {
    encrypt: true,
    headers: sessionId ? { sessionid: sessionId } : {}
  });
}
```

### Step 3: Auto-Fetch OTP
**Component**: `OtpVerification.tsx`

- WebOTP listener activates
- Browser intercepts incoming SMS
- Extracts OTP code automatically
- Auto-fills input field
- Auto-submits when 4 digits received

### Step 4: Verify OTP
**API**: `verifyOtp.ts`

```typescript
export async function verifyOtp(
  request: VerifyOtpRequest,
  sessionId?: string
): Promise<ApiResponse<any>> {
  const body: any = {
    otp: request.otp,
    is_register: request.is_register,
    source: request.source,
    domain: window.location.hostname
  };

  if (request.source === LoginIdentifierType.PHONE) {
    body.phone = request.phone;
    body.phone_code = request.phone_code;
  } else {
    body.email = request.phone;
  }

  return apiClient.post(ApiEndpoint.VERIFY_OTP, body, {
    encrypt: true,
    headers: sessionId ? { sessionid: sessionId } : {}
  });
}
```

