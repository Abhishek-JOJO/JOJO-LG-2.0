### Auto-Submit Logic

```typescript
const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
  hasSubmittedRef.current = false; // Reset submission lock
  
  const val = e.target.value.replace(/\D/g, "").slice(0, 4); // Sanitize to 4 digits
  setOtpValue(val);

  // Auto-submit when complete
  if (val.length === 4) {
    triggerSubmit(val);
  }
};
```

### Resend Timer

```typescript
const [timer, setTimer] = useState(15); // 15-second countdown

useEffect(() => {
  if (timer > 0) {
    const interval = setInterval(() => {
      setTimer((prev) => prev - 1);
    }, 1000);
    return () => clearInterval(interval);
  }
}, [timer]);

// UI Display
{timer > 0 ? (
  <span>Resend OTP in <strong>00:{timer < 10 ? `0${timer}` : timer}</strong></span>
) : (
  <button onClick={handleResend}>Resend OTP</button>
)}
