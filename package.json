{
  "name": "web",
  "version": "2.2.32",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.development -- next dev --experimental-https",
    "dev:stage": "dotenv -e .env.stage -- next dev --experimental-https",
    "dev:prod": "dotenv -e .env.production -- next dev --experimental-https",
    "build": "set NODE_OPTIONS=--no-deprecation && tsx scripts/build/index.ts",
    "build:prod": "tsx scripts/build/index.ts --prod",
    "build:stage": "tsx scripts/build/index.ts --stage",
    "build:dev": "tsx scripts/build/index.ts --dev",
    "next:build": "next build",
    "start": "next start",
    "serve": "npx serve out",
    "package:wgt": "tizen package -t wgt -- ./out",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-query-devtools": "^5.100.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clevertap-web-sdk": "^2.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "hls.js": "^1.6.16",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.8.0",
    "msw": "^2.13.3",
    "mux.js": "^6.3.0",
    "next": "16.2.3",
    "next-intl": "^4.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shaka-player": "^5.1.8",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
